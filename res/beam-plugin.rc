// beam-plugin.exe (plugin developer tool) resources.
#include <windows.h>
#include "resource.h"

IDI_APP ICON "beam.ico"

PLUGINS_MD RCDATA "PLUGINS.md"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "beam-plugin.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Beam plugin developer tool"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "beam-plugin"
            VALUE "OriginalFilename", "beam-plugin.exe"
            VALUE "ProductName", "Beam"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
